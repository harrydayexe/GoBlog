{{define "head"}}
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{{.Description}}">

    <title>{{.PageTitle}} | {{.SiteTitle}}</title>

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="{{.PageTitle}}">
    <meta property="og:description" content="{{.Description}}">
    <meta property="og:type" content="{{or .OGType "website"}}">
    <meta property="og:site_name" content="{{.SiteTitle}}">
    {{if .CanonicalURL}}
    <meta property="og:url" content="{{.CanonicalURL}}">
    <link rel="canonical" href="{{.CanonicalURL}}">
    {{end}}

    <!-- Article Meta Tags (post pages only) -->
    {{with .Article}}
    <meta property="article:published_time" content="{{.PublishedISO}}">
    {{with .Author}}
    <meta property="article:author" content="{{.}}">
    {{end}}
    {{range .Tags}}
    <meta property="article:tag" content="{{.}}">
    {{end}}
    {{end}}

    <!-- Schema.org Structured Data -->
    {{with .Article}}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": "{{$.PageTitle}}",
        "description": "{{$.Description}}",
        "datePublished": "{{.PublishedISO}}",
        {{with .Author}}"author": {"@type": "Person", "name": "{{.}}"},{{end}}
        {{if .Tags}}"keywords": [{{range $i, $tag := .Tags}}{{if $i}}, {{end}}"{{$tag}}"{{end}}],{{end}}
        {{if $.CanonicalURL}}"url": "{{$.CanonicalURL}}",
        "mainEntityOfPage": {"@type": "WebPage", "@id": "{{$.CanonicalURL}}"},{{end}}
        "publisher": {"@type": "Organization", "name": "{{$.SiteTitle}}"}
    }
    </script>
    {{else}}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        {{if .CanonicalURL}}"url": "{{.CanonicalURL}}",{{end}}
        "description": "{{.Description}}",
        "name": "{{.SiteTitle}}"
    }
    </script>
    {{end}}

    <!-- Feed Discovery -->
    {{if .FeedsEnabled}}
    <link rel="alternate" type="application/rss+xml" title="{{.SiteTitle}} RSS Feed" href="{{.BlogRoot}}rss.xml">
    <link rel="alternate" type="application/atom+xml" title="{{.SiteTitle}} Atom Feed" href="{{.BlogRoot}}atom.xml">
    {{end}}

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Custom Styles -->
    <style>
        /* Prose styling for blog content */
        .prose img {
            max-width: 100%;
            height: auto;
            border-radius: 0.5rem;
            margin: 1.5rem 0;
        }

        .prose pre {
            background-color: #1e293b;
            color: #e2e8f0;
            padding: 1rem;
            border-radius: 0.5rem;
            overflow-x: auto;
        }

        .prose code {
            background-color: #f1f5f9;
            color: #dc2626;
            padding: 0.125rem 0.25rem;
            border-radius: 0.25rem;
            font-size: 0.875em;
        }

        .prose pre code {
            background-color: transparent;
            color: inherit;
            padding: 0;
        }

        .prose a {
            color: #2563eb;
            text-decoration: underline;
        }

        .prose a:hover {
            color: #1d4ed8;
        }
    </style>
</head>
{{end}}
